# Copy to .env and fill in:
#   cp .env.example .env && chmod 600 .env
# The bot loads .env automatically. Never commit .env or a real private key.

# The Odds API (https://the-odds-api.com) — needed for paper and live entry signals.
ODDS_API_KEY=your_odds_api_key_here

# Kalshi API credentials — needed only for live trading (not for paper mode or unit tests).
KALSHI_API_KEY_ID=your_kalshi_api_key_id_here
KALSHI_PRIVATE_KEY_PATH=/path/to/kalshi-private-key.pem

# Or paste the PEM contents instead of a path (newlines may be written as \n):
# KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...paste key here...\n-----END RSA PRIVATE KEY-----"
